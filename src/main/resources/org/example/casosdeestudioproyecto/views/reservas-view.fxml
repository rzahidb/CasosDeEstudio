<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900" prefHeight="660" style="-fx-background-color: #F4F6F9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.casosdeestudioproyecto.controllers.ReservasController">
    <top>
        <VBox spacing="6" style="-fx-background-color: #1E3A8A;">
            <padding><Insets top="14" bottom="14" left="24" right="24"/></padding>
            <Label text="CASO 1 — RESERVA CONCURRENTE DE ENTRADAS"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="3 agentes (Runnable + Thread) | 10 intentos por agente | 20 entradas compartidas"
                   style="-fx-text-fill: #DBEAFE; -fx-font-size: 12px;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="16" bottom="16" left="24" right="24"/></padding>
            <GridPane hgap="18" vgap="10" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6;">
                <padding><Insets top="14" bottom="14" left="18" right="18"/></padding>
                <Label text="Estado de la simulación:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblEstado" text="Listo" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #1D4ED8;"/>
                <Label text="Entradas iniciales:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblEntradasIniciales" text="20" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label text="Entradas disponibles:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblEntradasDisponibles" text="20" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #047857; -fx-font-weight: bold;"/>
                <Label text="Reservas confirmadas:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblReservasConfirmadas" text="0" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-text-fill: #15803D; -fx-font-weight: bold;"/>
                <Label text="Solicitudes rechazadas:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblSolicitudesRechazadas" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #B91C1C; -fx-font-weight: bold;"/>
                <Label text="Solicitudes procesadas:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTotalSolicitudes" text="0 / 30" GridPane.columnIndex="3" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            </GridPane>
            <VBox spacing="6" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6;">
                <padding><Insets top="10" bottom="10" left="18" right="18"/></padding>
                <Label fx:id="lblResumenAgentes" wrapText="true"
                       text="Agente 1: 0 conf. / 0 rech. | Agente 2: 0 conf. / 0 rech. | Agente 3: 0 conf. / 0 rech."
                       style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
                <ProgressBar fx:id="barraProgreso" maxWidth="1.7976931348623157E308" prefHeight="20" progress="0"/>
                <Label fx:id="lblContadorPruebas" text="Simulaciones completadas en esta sesión: 0"
                       style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
            </VBox>
            <Label text="Registro de operaciones en tiempo real:" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="txtRegistro" editable="false" prefHeight="260" VBox.vgrow="ALWAYS"
                      style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 12px;"/>
            <Separator/>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button fx:id="btnIniciar" text="Iniciar Simulación" onAction="#iniciarSimulacion"
                        mnemonicParsing="false" prefWidth="190" prefHeight="38"
                        style="-fx-background-color: #1D4ED8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnLimpiar" text="Restablecer Campos" onAction="#accionLimpiarCampos"
                        mnemonicParsing="false" prefWidth="170" prefHeight="38"
                        style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolverMenu" text="Volver al menú" onAction="#volverAlMenu"
                        mnemonicParsing="false" prefWidth="170" prefHeight="38"
                        style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>