<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900" prefHeight="660" style="-fx-background-color: #F4F6F9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.casosdeestudioproyecto.controllers.CajaController">
    <top>
        <VBox spacing="6" style="-fx-background-color: #3730A3;">
            <padding><Insets top="14" bottom="14" left="24" right="24"/></padding>
            <Label text="CASO 3 — CAJA DE VENTAS CON VENDEDORES CONCURRENTES"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="3 vendedores concurrentes | 5 ventas de C$100 cada uno | Caja sincronizada | Cancelación cooperativa"
                   style="-fx-text-fill: #E0E7FF; -fx-font-size: 12px;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets top="14" bottom="14" left="24" right="24"/></padding>
            <GridPane hgap="24" vgap="8" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6;">
                <padding><Insets top="12" bottom="12" left="18" right="18"/></padding>
                <Label text="Estado de la simulación:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblEstado" text="Listo" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #4338CA; -fx-font-weight: bold;"/>
                <Label text="Cantidad total de ventas:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTotalVentas" text="0 / 15" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label text="Recaudación acumulada:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTotalRecaudado" text="C$0" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #15803D; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="Progreso global (15 ventas):" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <ProgressBar fx:id="barraGeneral" prefHeight="18" prefWidth="220" progress="0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>
            <GridPane hgap="16" vgap="8" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6;">
                <padding><Insets top="12" bottom="12" left="18" right="18"/></padding>
                <Label text="Vendedor 1:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <ProgressBar fx:id="barraVendedor1" prefHeight="16" prefWidth="240" progress="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label fx:id="lblVendedor1" text="0 / 5 ventas (C$0)" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label text="Vendedor 2:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <ProgressBar fx:id="barraVendedor2" prefHeight="16" prefWidth="240" progress="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="lblVendedor2" text="0 / 5 ventas (C$0)" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label text="Vendedor 3:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <ProgressBar fx:id="barraVendedor3" prefHeight="16" prefWidth="240" progress="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label fx:id="lblVendedor3" text="0 / 5 ventas (C$0)" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            </GridPane>
            <Label text="Registro de ventas concurrentes en Caja:" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="txtRegistro" editable="false" prefHeight="225" VBox.vgrow="ALWAYS"
                      style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 12px;"/>
            <Separator/>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button fx:id="btnIniciar" text="Iniciar Ventas" onAction="#iniciarSimulacion"
                        mnemonicParsing="false" prefWidth="170" prefHeight="38"
                        style="-fx-background-color: #4338CA; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelarSimulacion"
                        disable="true" mnemonicParsing="false" prefWidth="150" prefHeight="38"
                        style="-fx-background-color: #B91C1C; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnLimpiar" text="Restablecer Campos" onAction="#accionLimpiarCampos"
                        mnemonicParsing="false" prefWidth="170" prefHeight="38"
                        style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolverMenu" text="Volver al menú" onAction="#volverAlMenu"
                        mnemonicParsing="false" prefWidth="170" prefHeight="38"
                        style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>